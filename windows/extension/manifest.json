{
  "manifest_version": 3,
  "name": "Purrch",
  "short_name": "Purrch",
  "version": "1.0.0",
  "description": "Shows and controls the YouTube videos open in this browser from Purrch's pill on Windows.",
  "key": "",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["nativeMessaging", "scripting", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["relay.js"],
      "run_at": "document_idle"
    }
  ]
}
