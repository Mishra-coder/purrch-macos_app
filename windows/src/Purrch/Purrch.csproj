<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK projection gives access to the system media controls (Now Playing). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 1809: the oldest version with the media session API. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has none of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on macOS and Linux; it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Purrch</RootNamespace>
    <AssemblyName>Purrch</AssemblyName>
    <ApplicationIcon>Assets\Purrch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 is a WinForms hint; WPF takes per-monitor DPI from the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>0.1.0</Version>
    <Product>Purrch</Product>
    <Company>Devendra Mishra</Company>
    <Copyright>Copyright © 2026 Devendra Mishra</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share type names (Application, Point, Color); keep WinForms explicit. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Mascot.png" />
    <Resource Include="Assets\Tray.ico" />
    <!-- Made by windows/tools/make-emoji-catalog.sh from the Mac app's emoji list. -->
    <EmbeddedResource Include="Assets\Emoji.tsv" LogicalName="Purrch.Emoji.tsv" />
    <!-- The browser extension (windows/extension), written out only when "Connect browser" is clicked in Settings. -->
    <EmbeddedResource Include="..\..\extension\*" Exclude="..\..\extension\README.md"
                      LogicalName="Purrch.Extension.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.1.0" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <!-- WMI, for the battery cycle count on the System page. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Windows toasts and scheduled toasts for an unpackaged app (Timers, water reminders). -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Reads Chrome, Edge, Brave and Vivaldi's download list for real progress. Brings e_sqlite3 for x64 and arm64. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <!-- Sign in with Microsoft for Calendar (Outlook calendars and To Do), through the system browser. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
    <!-- DPAPI, which keeps the Microsoft sign-in cache encrypted for this Windows user. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
