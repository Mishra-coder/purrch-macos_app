<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 icon font, falling back to the Windows 10 one (same code points). -->
    <FontFamily x:Key="Purrch.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Purrch.Font">Segoe UI</FontFamily>

    <Style x:Key="Purrch.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Purrch.Icons}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- A button that draws nothing but its content. -->
    <Style x:Key="Purrch.PlainButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Purrch.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Raised card: the surface every module and settings row sits on. -->
    <Style x:Key="Purrch.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Purrch.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Purrch.Hairline}" />
        <Setter Property="BorderThickness" Value="0.8" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <!-- On/off switch, the Windows counterpart of the Mac toggles. -->
    <Style x:Key="Purrch.Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource Purrch.Hairline}"
                            BorderBrush="{DynamicResource Purrch.SecondaryText}" BorderThickness="1">
                        <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left"
                                 Fill="{DynamicResource Purrch.SecondaryText}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Purrch.ThemeAccent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Purrch.ThemeAccent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Purrch.Background}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
