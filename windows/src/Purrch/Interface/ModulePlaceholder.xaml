<UserControl x:Class="Purrch.Interface.ModulePlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Stands in for a module that hasn't been built for Windows yet. -->
    <Border Style="{StaticResource Purrch.Card}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                    Background="{DynamicResource Purrch.AccentSoft}">
                <TextBlock x:Name="Glyph" Style="{StaticResource Purrch.Glyph}" FontSize="24" />
            </Border>
            <TextBlock x:Name="Title" Margin="0,14,0,0" HorizontalAlignment="Center"
                       FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Purrch.Text}" />
            <TextBlock x:Name="Subtitle" Margin="0,4,0,0" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource Purrch.SecondaryText}" />
            <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource Purrch.SecondaryText}" Opacity="0.8"
                       Text="Coming soon to Purrch for Windows" />
        </StackPanel>
    </Border>
</UserControl>
